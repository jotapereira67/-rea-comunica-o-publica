€	␀€␀€€€€€Ó$%'(WNS.base[NS.relative€␀€€_Q.data:image/png;base64,Ò+,-.Z$classnameX$classesUNSURL¢-/XNSObject#AÇâ…ö|åYimage/png<Ñ#ïÿÿÿÿÿÿÒ+,56]NSURLResponse¢7/]NSURLResponse␀␀␀␀$␀)␀2␀7␀I␀L␀b␀d␀p␀v␀␀”␀¶␀¹␀Û␀ıADfˆ‹‘“•—™›Ÿ¡¨°¼¾ÀÂRôRùSSSSSS(S2S5S>SCSQST␀␀␀␀␀␀␀␀␀␀␀␀␀8␀␀␀␀␀␀␀␀␀␀␀␀␀␀Sb_Q.data:image/png;base64,Õ8	9:;<=_WebResourceFrameNameUUTF-8O␀}b<!DOCTYPE html><html lang="pt-BR"><head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>AgÃªncia digital na comunicaÃ§Ã£o pÃºblica â€” Ãrea ComunicaÃ§Ã£o</title>
<meta name="description" content="O que Ã©, o que faz e como contratar uma agÃªncia de comunicaÃ§Ã£o digital no setor pÃºblico. Material de orientaÃ§Ã£o a gestores, pela Ãrea ComunicaÃ§Ã£o.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
<link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600&amp;display=swap" rel="stylesheet">
<style>
/* ============================================================
   SISTEMA DE DESIGN â€” edite tudo aqui
   ============================================================ */
:root{
  --vermelho:        #e30613;
  --vermelho-escuro: #b30410;
  --vermelho-claro:  #ff5862;
  --tinta:           #1a1a1a;
  --tinta-suave:     #4a4a4a;
  --cinza:           #8a8a8a;
  --linha:           #e6e3de;
  --papel:           #faf8f5;
  --papel-puro:      #ffffff;
  --escuro:          #1a1a1a;
  --escuro-card:     #262626;
  --fonte: 'Poppins', -apple-system, BlinkMacSystemFont, sans-serif;
  --max:    1180px;
  --gap:    clamp(58px, 8vw, 130px);
  --radio:  14px;
}
*{margin:0;padding:0;box-sizing:border-box}
p,h1,h2,h3,h4,li,dd,dt,td,th{overflow-wrap:break-word;word-break:normal;hyphens:auto}
html{scroll-behavior:smooth;scroll-padding-top:74px}
body{
  font-family:var(--fonte);background:var(--papel);color:var(--tinta);
  line-height:1.65;-webkit-font-smoothing:antialiased;overflow-x:hidden;
}
img{max-width:100%;display:block}
a{color:inherit}
svg{display:block}

/* ---- Tipos utilitÃ¡rios ---- */
.eyebrow{font-style:italic;font-weight:500;font-size:.95rem;color:var(--vermelho);margin-bottom:14px}
.eyebrow.claro{color:var(--vermelho-claro)}
h2{font-weight:800;line-height:1.08;letter-spacing:-.022em;
  font-size:clamp(1.85rem,4.6vw,3.3rem);margin-bottom:26px}
h3{font-weight:700;line-height:1.18;letter-spacing:-.015em;
  font-size:clamp(1.2rem,2vw,1.55rem);margin-bottom:14px}
p{font-weight:400;font-size:1.05rem;color:var(--tinta-suave)}
.lead{font-size:1.16rem;color:var(--tinta);font-weight:400;max-width:62ch}
strong{font-weight:600;color:var(--tinta)}
.tarja{background:var(--vermelho);color:#fff;padding:.03em .26em;
  box-decoration-break:clone;-webkit-box-decoration-break:clone}

/* ============================================================
   NAVEGAÃ‡ÃƒO
   ============================================================ */
nav{position:fixed;top:0;left:0;right:0;z-index:100;
  background:rgba(250,248,245,.94);
  backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);
  border-bottom:1px solid var(--linha)}
.nav-in{max-width:var(--max);margin:0 auto;padding:0 28px;
  height:74px;display:flex;align-items:center;justify-content:space-between}
.marca{display:flex;align-items:center;gap:11px;text-decoration:none;flex-shrink:0}
.marca img{width:40px;height:40px}
.marca .nome{font-weight:600;font-size:.98rem;letter-spacing:-.01em;color:var(--tinta);line-height:1.2}
.marca .nome b{color:var(--vermelho);font-weight:700}
.menu{display:flex;gap:4px;list-style:none}
.menu a{text-decoration:none;font-weight:500;font-size:.9rem;
  padding:9px 13px;border-radius:8px;color:var(--tinta-suave);
  transition:background .15s,color .15s}
.menu a:hover{background:#efece7;color:var(--tinta)}
.menu a.ativo{color:var(--vermelho);font-weight:600}
.burger{display:none;background:none;border:0;cursor:pointer;padding:8px}
.burger span{display:block;width:24px;height:2.4px;background:var(--tinta);
  margin:5px 0;border-radius:2px;transition:.25s}

/* ============================================================
   SEÃ‡Ã•ES
   ============================================================ */
.secao{padding:var(--gap) 0}
.secao.branca{background:var(--papel-puro)}
.secao.escura{background:var(--escuro);color:#efece7}
.secao.escura h2,.secao.escura h3{color:#fff}
.secao.escura p,.secao.escura .cabeca p{color:#bdb9b2}
.secao.escura .lead{color:#e8e5df}
.secao.escura strong{color:#fff}
.wrap{max-width:var(--max);margin:0 auto;padding:0 28px}
.cabeca{max-width:760px;margin-bottom:50px}
.cabeca p{margin-top:18px}

/* nome do capÃ­tulo (substitui "CapÃ­tulo 01") */
.cap-rotulo{
  display:inline-flex;align-items:center;gap:10px;
  font-weight:700;font-size:.8rem;letter-spacing:.14em;
  text-transform:uppercase;color:var(--vermelho);margin-bottom:18px;
}
.cap-rotulo::before{
  content:"";width:30px;height:2.5px;background:var(--vermelho);border-radius:2px;
}

/* ============================================================
   CAPA / HERO
   ============================================================ */
.hero{padding:130px 0 var(--gap);position:relative;overflow:hidden}
.hero::before{content:"";position:absolute;top:-140px;right:-180px;
  width:620px;height:620px;border-radius:50%;
  background:repeating-radial-gradient(circle,transparent 0 17px,rgba(0,0,0,.04) 17px 18px);
  pointer-events:none}
.hero .wrap{position:relative;display:grid;grid-template-columns:1.45fr .8fr;
  gap:40px;align-items:center}
.hero-tag{font-style:italic;font-weight:500;color:var(--vermelho);
  font-size:1rem;margin-bottom:20px}
.hero h1{font-weight:800;letter-spacing:-.03em;line-height:1.02;
  font-size:clamp(2.5rem,6vw,4.9rem);max-width:15ch}
.hero h1 .tarja{display:inline-block;margin-top:.06em}
.hero .sub{font-size:clamp(1.05rem,1.6vw,1.28rem);color:var(--tinta-suave);
  max-width:54ch;margin-top:24px;line-height:1.55}
.hero .entrada{margin-top:26px;max-width:58ch;font-size:1.05rem;color:var(--tinta-suave)}
.hero .mini-nota{margin-top:26px;font-style:italic;font-weight:500;
  color:var(--cinza);font-size:.92rem;
  padding-left:14px;border-left:3px solid var(--linha)}
.hero-ilustra{display:flex;align-items:center;justify-content:center}
.hero-ilustra svg{width:100%;max-width:320px;height:auto}

.trilha{display:grid;grid-template-columns:repeat(6,1fr);gap:12px;
  margin-top:54px;grid-column:1 / -1}
.trilha a{text-decoration:none;background:var(--papel-puro);
  border:1px solid var(--linha);border-radius:var(--radio);
  padding:16px 14px;transition:transform .18s,box-shadow .18s,border-color .18s}
.trilha a:hover{transform:translateY(-4px);box-shadow:0 12px 28px rgba(0,0,0,.08);
  border-color:#d8d4cd}
.trilha .t-n{font-weight:700;color:var(--vermelho);font-size:.78rem;letter-spacing:.1em}
.trilha .t-l{font-weight:600;font-size:.93rem;margin-top:7px;line-height:1.25;letter-spacing:-.01em}

/* ============================================================
   ESTATÃSTICAS (cap 1)
   ============================================================ */
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin-top:8px}
.stat{background:var(--escuro-card);border-radius:var(--radio);
  padding:28px 22px;position:relative;overflow:hidden}
.stat::after{content:"";position:absolute;left:0;bottom:0;width:100%;height:3px;
  background:var(--vermelho)}
.stat .num{font-weight:800;font-size:clamp(2.1rem,3.2vw,2.8rem);
  color:#fff;letter-spacing:-.03em;line-height:1}
.stat .num .un{font-size:.5em;font-weight:600;color:var(--vermelho-claro)}
.stat .txt{margin-top:11px;font-size:.93rem;color:#bdb9b2;line-height:1.4}
/* destaque para dados digitais/redes â€” vermelho */
.stat.realce{background:linear-gradient(160deg,#3a0608,#1c0203);
  box-shadow:0 0 0 1.5px var(--vermelho) inset}
.stat.realce .num{color:var(--vermelho-claro)}
.stat.realce .num .un{color:#fff}
.stat.realce .txt{color:#e9c9cb}
.stat.realce::after{height:4px}
.fonte-nota{margin-top:24px;font-size:.84rem;color:#7a7770;font-style:italic}

/* ============================================================
   FLUXO 5 PASSOS (cap 1)
   ============================================================ */
.fluxo{display:grid;grid-template-columns:repeat(5,1fr);gap:0;margin-top:8px}
.passo{position:relative;padding:0 16px}
.passo:not(:last-child)::after{content:"";position:absolute;right:-7px;top:24px;
  width:14px;height:14px;border-top:2.5px solid var(--vermelho);
  border-right:2.5px solid var(--vermelho);transform:rotate(45deg);z-index:2}
.passo .bola{width:50px;height:50px;border-radius:14px;
  background:var(--vermelho);color:#fff;display:flex;align-items:center;
  justify-content:center;font-weight:800;font-size:1.2rem;margin-bottom:16px}
.passo h4{font-weight:700;font-size:1.02rem;margin-bottom:7px;letter-spacing:-.01em}
.passo p{font-size:.91rem;line-height:1.5}

.fechamento{margin-top:42px;background:var(--papel-puro);
  border:1px solid var(--linha);border-left:4px solid var(--vermelho);
  border-radius:var(--radio);padding:24px 28px}
.fechamento .rot{font-weight:700;color:var(--vermelho);font-size:.82rem;
  letter-spacing:.1em;margin-bottom:7px}
.fechamento p{font-size:1.05rem;color:var(--tinta)}
.secao.escura .fechamento{background:var(--escuro-card);border-color:#3a3a3a;
  border-left-color:var(--vermelho)}
.secao.escura .fechamento p{color:#fff}

/* ============================================================
   TRÃŠS FRENTES com Ã­cones (cap 2)
   ============================================================ */
.frentes{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:8px}
.frente{background:var(--papel-puro);border:1px solid var(--linha);
  border-radius:var(--radio);padding:30px 26px;
  transition:transform .18s,box-shadow .18s}
.frente:hover{transform:translateY(-4px);box-shadow:0 14px 30px rgba(0,0,0,.07)}
.frente .ic-wrap{width:62px;height:62px;border-radius:16px;background:#fdeaeb;
  display:flex;align-items:center;justify-content:center;margin-bottom:18px}
.frente .ic-wrap svg{width:34px;height:34px}

.entregas{display:grid;grid-template-columns:1fr 1fr;gap:14px 28px;margin-top:8px}
.entrega{display:flex;gap:14px;padding:16px 0;border-top:1px solid var(--linha)}
.entrega .ic-e{flex-shrink:0;width:42px;height:42px;border-radius:11px;
  background:#fdeaeb;display:flex;align-items:center;justify-content:center}
.entrega .ic-e svg{width:24px;height:24px}
.entrega h4{font-weight:600;font-size:1.01rem;margin-bottom:3px}
.entrega p{font-size:.92rem;line-height:1.45}

.destaque-bloco{margin-top:38px;background:var(--escuro);color:#fff;
  border-radius:var(--radio);padding:36px 40px;
  display:grid;grid-template-columns:auto 1fr;gap:28px;align-items:center}
.destaque-bloco .db-ic{width:78px;height:78px;flex-shrink:0}
.destaque-bloco .rot{font-style:italic;color:var(--vermelho-claro);
  font-weight:500;margin-bottom:10px}
.destaque-bloco p{color:#dedad3;font-size:1.08rem}
.destaque-bloco strong{color:#fff}

/* ============================================================
   DUAS FUNÃ‡Ã•ES (cap 3)
   ============================================================ */
.duas{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin-top:8px}
.func{background:var(--papel-puro);border:1px solid var(--linha);
  border-radius:var(--radio);padding:32px 30px}
.func .selo{display:inline-block;font-weight:700;font-size:.76rem;
  letter-spacing:.12em;padding:6px 13px;border-radius:30px;margin-bottom:16px}
.func.pub .selo{background:#f0ede8;color:var(--tinta-suave)}
.func.dig .selo{background:var(--vermelho);color:#fff}
.func h3{font-size:1.45rem}
.func .desc{font-size:.98rem;color:var(--tinta-suave);margin-bottom:20px}
.func dl{display:grid;gap:13px}
.func dt{font-weight:700;font-size:.78rem;letter-spacing:.07em;
  color:var(--vermelho);margin-bottom:2px}
.func dd{font-size:.95rem;color:var(--tinta-suave);line-height:1.5}
.linha-corte{margin-top:24px;background:var(--escuro);color:#fff;
  border-radius:var(--radio);padding:32px 36px;text-align:center}
.linha-corte .rot{font-style:italic;color:var(--vermelho-claro);
  font-weight:500;font-size:.93rem;margin-bottom:10px}
.linha-corte .frase{font-weight:700;font-size:clamp(1.25rem,2.4vw,1.8rem);
  letter-spacing:-.02em;line-height:1.25}
.linha-corte p{color:#bdb9b2;margin-top:14px;max-width:64ch;
  margin-left:auto;margin-right:auto}
.coexistem{margin-top:22px;border:1px solid var(--linha);
  border-radius:var(--radio);padding:26px 30px;background:var(--papel-puro)}
.coexistem p{font-size:1.04rem;color:var(--tinta)}

/* ============================================================
   CONTRATAÃ‡ÃƒO (cap 4)
   ============================================================ */
.contrat{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;margin-top:8px}
.cpasso{background:var(--papel-puro);border:1px solid var(--linha);
  border-radius:var(--radio);padding:24px 22px;position:relative}
.cpasso .cn{font-weight:800;font-size:2.4rem;color:#f0ede8;
  letter-spacing:-.04em;line-height:.8;margin-bottom:6px}
.cpasso h4{font-weight:700;font-size:1.05rem;margin-bottom:8px;letter-spacing:-.01em}
.cpasso p{font-size:.91rem;line-height:1.5}

.tabela-leg{margin-top:44px;width:100%;border-collapse:collapse;
  background:var(--papel-puro);border-radius:var(--radio);overflow:hidden;
  border:1px solid var(--linha)}
.tabela-leg thead{background:var(--escuro)}
.tabela-leg th{text-align:left;padding:15px 20px;color:#fff;font-weight:600;
  font-size:.8rem;letter-spacing:.06em;text-transform:uppercase}
.tabela-leg td{padding:16px 20px;border-top:1px solid var(--linha);
  font-size:.95rem;vertical-align:top;color:var(--tinta-suave)}
.tabela-leg tr td:first-child{font-weight:600;color:var(--tinta)}
.tabela-leg .lei{font-weight:600;color:var(--vermelho);font-size:.91rem}
.regra-pratica{margin-top:24px;display:flex;gap:16px;align-items:flex-start;
  background:#fdeaeb;border-radius:var(--radio);padding:22px 26px}
.regra-pratica .rp-ic{flex-shrink:0;width:36px;height:36px}
.regra-pratica p{color:var(--tinta);font-size:1.01rem}

.tec-preco{margin-top:52px;background:var(--escuro);color:#fff;
  border-radius:var(--radio);padding:42px 44px}
.tec-preco h3{color:#fff;font-size:1.55rem;max-width:26ch}
.tec-preco p{color:#bdb9b2;margin-top:15px;max-width:66ch}
.tec-preco .grande{font-weight:800;font-size:clamp(1.4rem,3vw,2.1rem);
  letter-spacing:-.02em;color:#fff;margin:22px 0 8px;line-height:1.2}
.tec-preco .grande .tarja{display:inline-block}

/* ============================================================
   VANTAGENS (cap 5)
   ============================================================ */
.comp-cab{display:grid;grid-template-columns:190px 1fr 1fr;
  margin-bottom:4px;padding:0 24px}
.comp-cab span{font-weight:700;font-size:.76rem;letter-spacing:.1em;
  text-transform:uppercase;color:var(--cinza)}
.comp-cab span:nth-child(3){color:var(--vermelho)}
.compara{display:grid;gap:12px;margin-top:8px}
.linha-comp{display:grid;grid-template-columns:190px 1fr 1fr;
  background:var(--papel-puro);border:1px solid var(--linha);
  border-radius:var(--radio);overflow:hidden}
.linha-comp .aspecto{padding:20px 22px;font-weight:700;font-size:1rem;
  background:#f4f1ec;display:flex;align-items:center;letter-spacing:-.01em}
.linha-comp .sem,.linha-comp .com{padding:20px 22px;font-size:.93rem;line-height:1.5}
.linha-comp .sem{color:var(--cinza);border-left:1px solid var(--linha)}
.linha-comp .com{color:var(--tinta);border-left:3px solid var(--vermelho);
  background:#fffdfb}
.servir{margin-top:32px;text-align:center}
.servir .frase{font-weight:800;font-size:clamp(1.5rem,3.4vw,2.5rem);
  letter-spacing:-.025em}
.erros{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:8px}
.erro{display:flex;gap:16px;background:var(--papel-puro);
  border:1px solid var(--linha);border-radius:var(--radio);padding:22px 24px}
.erro .x{flex-shrink:0;width:32px;height:32px;border-radius:8px;
  background:var(--vermelho);color:#fff;font-weight:700;font-size:1.05rem;
  display:flex;align-items:center;justify-content:center}
.erro h4{font-weight:700;font-size:1.02rem;margin-bottom:5px;letter-spacing:-.01em}
.erro p{font-size:.92rem;line-height:1.5}

/* ============================================================
   FONTES (cap 6)
   ============================================================ */
.aviso-fonte{display:flex;gap:16px;align-items:flex-start;
  background:#fdeaeb;border-radius:var(--radio);padding:24px 28px;margin-bottom:34px}
.aviso-fonte .av-ic{flex-shrink:0;width:36px;height:36px}
.aviso-fonte p{color:var(--tinta);font-size:1rem}
.grupo-fonte{margin-bottom:30px}
.grupo-fonte h3{font-size:1.08rem;color:var(--vermelho);
  border-bottom:2px solid var(--linha);padding-bottom:10px;margin-bottom:4px}
.link-fonte{display:flex;justify-content:space-between;align-items:center;
  gap:20px;padding:18px 0;border-bottom:1px solid var(--linha);
  text-decoration:none;transition:padding-left .15s}
.link-fonte:hover{padding-left:8px}
.link-fonte .lf-txt h4{font-weight:600;font-size:1.03rem;margin-bottom:3px}
.link-fonte .lf-txt p{font-size:.91rem}
.link-fonte .seta{flex-shrink:0;width:40px;height:40px;border-radius:50%;
  border:1.5px solid var(--linha);display:flex;align-items:center;
  justify-content:center;color:var(--vermelho);transition:background .15s,border-color .15s}
.link-fonte .seta svg{width:17px;height:17px}
.link-fonte:hover .seta{background:var(--vermelho);border-color:var(--vermelho);color:#fff}
.pendente{font-size:.76rem;font-style:italic;color:var(--cinza);
  background:#f0ede8;padding:3px 9px;border-radius:20px;white-space:nowrap}
.cta-fontes{margin-top:30px;background:var(--escuro);border-radius:var(--radio);
  padding:32px 36px;display:flex;justify-content:space-between;
  align-items:center;gap:24px;flex-wrap:wrap}
.cta-fontes .ct-txt h3{color:#fff;font-size:1.2rem;margin-bottom:5px}
.cta-fontes .ct-txt p{color:#bdb9b2;font-size:.95rem}
.cta-fontes a{flex-shrink:0;background:var(--vermelho);color:#fff;
  text-decoration:none;font-weight:600;font-size:.96rem;
  padding:14px 26px;border-radius:30px;transition:background .15s}
.cta-fontes a:hover{background:var(--vermelho-escuro)}

/* ============================================================
   RODAPÃ‰
   ============================================================ */
footer{background:var(--escuro);color:#bdb9b2;padding:60px 0 36px}
.foot-top{display:flex;justify-content:space-between;gap:40px;
  flex-wrap:wrap;padding-bottom:34px;border-bottom:1px solid #333}
